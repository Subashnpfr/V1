# SQLite database (default: backend/data/app.db)
DATABASE_URL=

# Session signing / cookie security
SESSION_SECRET=change-me-in-production
SESSION_COOKIE_NAME=v1_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# CORS — comma-separated browser origins allowed to send credentials
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js dev proxy target (frontend next.config.js)
BACKEND_URL=http://127.0.0.1:8000

# Optional: override frontend API base (default /backend same-origin proxy)
# NEXT_PUBLIC_API_BASE=/backend
